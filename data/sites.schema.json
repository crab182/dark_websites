{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dark_websites database",
  "type": "object",
  "required": ["version", "facets", "sites"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "facets": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "description", "facets", "tags", "added"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "description": { "type": "string", "minLength": 1 },
          "facets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["obscure", "niche", "kitsch", "broad", "deep", "narrow"]
            }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
